# Copy this file to .env and fill in your own values
# NEVER commit .env to version control

# ── Core ──────────────────────────────────────────────────────────────────────
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-random-secret-key-here

# Database.
# SQLite is fine locally. On Render's free tier the disk is EPHEMERAL, so a
# SQLite file is wiped on every deploy/restart — use a Render Postgres URL there.
DATABASE_URL=sqlite:///./nebula.db

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# Seed account created on first startup when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# ── Storage ───────────────────────────────────────────────────────────────────
# "local"     -> files on this server's disk (ephemeral on Render free tier)
# "filecloud" -> files in your FileCloud tenant
STORAGE_BACKEND=local

# Local backend: where user files live (namespaced per user automatically)
UPLOAD_DIR=./uploads

# Staging dir the runner executes from when STORAGE_BACKEND=filecloud
WORKSPACE_DIR=./workspace

# If FileCloud login fails at startup, keep serving from local disk instead of
# erroring on every request. Set to false if you'd rather fail loudly.
STORAGE_FALLBACK_LOCAL=true

# ── FileCloud ─────────────────────────────────────────────────────────────────
# Your tenant URL, no trailing slash, including https://
FILECLOUD_URL=https://yourtenant.filecloudonline.com

# A NORMAL FileCloud user account (not an admin-only login), with 2FA disabled.
# All Nebula users' files are stored under this one account.
FILECLOUD_ADMIN_USER=nebula-service
FILECLOUD_ADMIN_PASS=

# Top-level folder inside that account. Each app user gets a subfolder:
#   /Nebula/alice/main.py
FILECLOUD_ROOT_FOLDER=Nebula

FILECLOUD_TIMEOUT=30

# ── FileCloud API overrides ───────────────────────────────────────────────────
# Only set these if `python probe_filecloud.py` tells you to. The defaults are
# in app/services/filecloud.py; the probe reports any that don't match your
# tenant's API version.
# FC_EP_LOGIN=/core/loginguest
# FC_EP_FILE_LIST=/core/getfilelist
# FC_EP_DOWNLOAD=/core/downloadfile
# FC_EP_RENAME=/core/renamefile
# FC_UPLOAD_MODE=multipart
# FC_APPNAME=explorer

# ── Limits ────────────────────────────────────────────────────────────────────
# Kill any user program that runs longer than this (seconds).
MAX_EXECUTION_SECONDS=30

# Reject uploads bigger than this (bytes). Default 2 MB.
MAX_UPLOAD_BYTES=2097152
