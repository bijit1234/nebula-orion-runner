# Copy this to .env and fill in real values.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=your-secure-random-secret-key-here

# Comma-separated list of frontend origins allowed by CORS
# Local:  http://localhost,http://localhost:3000
# Cloud:  http://yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# URL the browser uses to reach the backend
# Local:  http://localhost:8000
# Cloud:  http://YOUR_SERVER_IP:8000  or  https://api.yourdomain.com
REACT_APP_API_URL=http://localhost:8000

# true = hot reload (dev only), false = production
DEBUG=false
